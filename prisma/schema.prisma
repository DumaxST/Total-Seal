generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum PriorityAlert{
  LOW
  HIGH
}
enum Compartiment{
  ONE
  TWO
  THREE
}

model Alert{
  id         String   @id @default(uuid())
  device    String
  idDevice String
  createdAt   DateTime @default(now())
  codeSeal String
  priority PriorityAlert
  compartiment Compartiment
  event String

  @@index([idDevice])
}